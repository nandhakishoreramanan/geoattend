PORT=3000

# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID (Web Application)
# 2. Add Authorized JavaScript Origin: http://localhost:3000
# 3. Add Authorized Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
